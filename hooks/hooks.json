{
  "description": "telegram-bridge: PreToolUse is the /stop brake (F6): synchronous, it refuses every tool call and stops Claude while the brake flag is set, and prints nothing otherwise. The other events are notices (F4): forwarded to the running channel over local IPC, each exits 0 with no output, also when the bridge is not running.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/brakeHook.ts"],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts", "Stop"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts", "Notification"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts", "UserPromptSubmit"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts", "PostToolUse"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
