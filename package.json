{
  "name": "telegram-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "telegram-bridge": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:plugin": "bun install --production --frozen-lockfile --no-summary 1>&2 && bun src/main.ts",
    "bridge": "bun src/cli.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:arch": "bun scripts/check-architecture.ts",
    "check": "bun run lint && bun run typecheck && bun run check:arch && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@resvg/resvg-wasm": "2.6.2",
    "grammy": "1.46.0",
    "uqr": "0.1.3",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
